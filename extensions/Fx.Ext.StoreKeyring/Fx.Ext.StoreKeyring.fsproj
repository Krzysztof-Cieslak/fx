<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The bundled fx.store.keyring package (spec §11.4, §16.4): a credential store in the OS keyring
    (Keychain, Credential Manager, Secret Service) over the host's IKeyring. A native extension: like
    every package under extensions/, it references the public SDK (src/Fx.Sdk) and nothing else. See
    README.md and docs/modules/auth.md.
  -->
  <ItemGroup>
    <Compile Include="StoreKeyring.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fx.Sdk\Fx.Sdk.fsproj" />
  </ItemGroup>
</Project>
