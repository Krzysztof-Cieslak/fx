<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The bundled fx.env.local package (spec §3, §9): environments on the host's own machine, the
    workspace an existing directory, envd in the host's process (embedded mode) or as a child. A
    native extension contributing one EnvProvider. Like every package under extensions/, it
    references the public SDK (src/Fx.Sdk) and nothing else; the architecture tests check the
    compiled assembly. See README.md.
  -->
  <ItemGroup>
    <Compile Include="EnvLocal.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fx.Sdk\Fx.Sdk.fsproj" />
  </ItemGroup>
</Project>
