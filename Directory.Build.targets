<Project>
  <!--
    Native AOT executables (FxNativeAot) set PublishAot only when a runtime identifier is given, so
    a publish without one would silently produce a JIT build. See Directory.Build.props "Restore".
  -->
  <Target Name="FxRequireRuntimeIdentifierForNativeAot"
          BeforeTargets="PrepareForPublish"
          Condition="'$(FxNativeAot)' == 'true' and '$(RuntimeIdentifier)' == ''">
    <Error Text="$(MSBuildProjectName) is published with Native AOT only: pass a runtime identifier, e.g. dotnet publish -r linux-x64." />
  </Target>

  <!--
    The pinned SQLite (native/sqlite, docs/spikes/sqlite.md): built for src/Fx.Sqlite and copied next
    to whatever references it; linked statically into a Native AOT executable that references it.
  -->
  <Import Project="$(MSBuildThisFileDirectory)native/sqlite/Sqlite.targets" />
</Project>
