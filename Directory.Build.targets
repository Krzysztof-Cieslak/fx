<Project>
  <!--
    Native AOT executables (FxNativeAot) set PublishAot only when a runtime identifier is given, so
    a publish without one would silently produce a JIT build. See Directory.Build.props "Restore".
  -->
  <Target Name="FxRequireRuntimeIdentifierForNativeAot"
          BeforeTargets="PrepareForPublish"
          Condition="'$(FxNativeAot)' == 'true' and '$(RuntimeIdentifier)' == ''">
    <Error Text="$(MSBuildProjectName) is published with Native AOT only: pass a runtime identifier, e.g. dotnet publish -r linux-x64." />
  </Target>

  <!--
    The public SDK's packages (docs/modules/sdk.md): a packable project is published as
    <FxPascalName>.<its name without "Fx.">, e.g. Fx.Sdk as Product.nugetPackage "Sdk", so a rename of
    the product renames the packages. Project references between packable projects become package
    dependencies.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageId>$(FxPascalName)$(MSBuildProjectName.Substring(2))</PackageId>
    <PackageTags>$(FxProductName);extensions;sdk</PackageTags>
  </PropertyGroup>

  <!--
    The pinned SQLite (native/sqlite, docs/spikes/sqlite.md): built for src/Fx.Sqlite and copied next
    to whatever references it; linked statically into a Native AOT executable that references it.
  -->
  <Import Project="$(MSBuildThisFileDirectory)native/sqlite/Sqlite.targets" />

  <!--
    The pinned tree-sitter and its grammars (native/tree-sitter, docs/spikes/tree-sitter.md): built for
    src/Fx.TreeSitter, copied next to whatever references it, linked statically into a Native AOT
    executable that references it.
  -->
  <Import Project="$(MSBuildThisFileDirectory)native/tree-sitter/TreeSitter.targets" />
</Project>
