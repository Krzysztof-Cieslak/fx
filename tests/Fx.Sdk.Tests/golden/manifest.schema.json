{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$",
      "description": "An extension id: dotted lowercase segments, e.g. \"acme.tools\"."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "A semantic version, e.g. \"1.2.0\"."
    },
    "description": {
      "type": "string"
    },
    "sdk": {
      "type": "string",
      "description": "The SDK API version the extension is built against, e.g. \"0.1\"."
    },
    "protocol": {
      "type": "string",
      "minLength": 1,
      "description": "The extension protocol version it speaks, e.g. \"1\"."
    },
    "placement": {
      "type": "string",
      "enum": [
        "host",
        "environment",
        "client"
      ],
      "description": "Where the extension runs: in the host, in an environment (envd) or in a client.",
      "default": "host"
    },
    "runtime": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "The extension runtime: declarative, native, process, or a contributed one."
    },
    "launch": {
      "$ref": "#/$defs/LaunchSpec"
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComponentRef"
      },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
        "description": "A capability name, e.g. \"fs.read\"."
      },
      "default": []
    },
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContributionDecl"
      },
      "default": []
    },
    "rpc": {
      "$ref": "#/$defs/RpcContract",
      "default": {
        "methods": []
      }
    },
    "replaces": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$",
        "description": "An extension id: dotted lowercase segments, e.g. \"acme.tools\"."
      },
      "default": []
    },
    "hash": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "sdk",
    "protocol",
    "runtime"
  ],
  "additionalProperties": false,
  "description": "An extension package's manifest.",
  "$defs": {
    "ComponentRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "description": "A component to install before the extension starts: its id and a version range."
    },
    "ContributionDecl": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*([.:/][a-z0-9][a-z0-9-]*)*$",
          "description": "A contribution type, e.g. \"extension-runtime\"."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "The contribution's id, unique for its type."
        },
        "value": {}
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "description": "A contribution: its type and id. Declarative extensions give its value; other runtimes provide it when they activate."
    },
    "LaunchSpec": {
      "type": "object",
      "properties": {
        "exe": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "envAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\*?$",
            "description": "An environment variable name; in deny lists, a trailing * matches any suffix."
          },
          "default": []
        },
        "envSet": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "envDeny": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\*?$",
            "description": "An environment variable name; in deny lists, a trailing * matches any suffix."
          },
          "default": []
        },
        "cwd": {
          "type": "string",
          "enum": [
            "owned",
            "workspace"
          ],
          "default": "owned"
        }
      },
      "required": [
        "exe"
      ],
      "additionalProperties": false,
      "description": "How the process runtime starts the extension. exe and args may use ${root} (the package directory) and ${exeSuffix}."
    },
    "MethodDecl": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(/[a-z][A-Za-z0-9]*)*$",
          "description": "The method's name; clients call ext/<extension id>/<name>."
        },
        "description": {
          "type": "string"
        },
        "params": {},
        "result": {}
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "A method of the extension's RPC contract; params and result are JSON Schemas."
    },
    "RpcContract": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodDecl"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
