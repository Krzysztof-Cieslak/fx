<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of src/Fx.Host: its pure parts (paths, config, trust, credentials, the static list, activity
    lines, the session index's JSON); the host started on scratch directories with the live
    interpreters and a scripted model (start, lock, config errors, trust, variants, sessions in an
    embedded environment, restarts); and fx run -p end to end on the bun-ts kernel, with the pinned
    Bun installed by the host's own installer (network, cached; skipped offline, required in CI).
  -->
  <ItemGroup>
    <Compile Include="..\Fx.Kernel.Tests\Repo.fs" Link="Bun\Repo.fs" />
    <Compile Include="..\Fx.Kernel.Tests\PinnedBun.fs" Link="Bun\PinnedBun.fs" />
    <Compile Include="Support.fs" />
    <Compile Include="UnitTests.fs" />
    <Compile Include="HostTests.fs" />
    <Compile Include="LiveTests.fs" />
    <Compile Include="ProtocolTests.fs" />
    <Compile Include="GrantPromptTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="golden\**" />
  </ItemGroup>

  <!--
    T135: idle thread-pool threads end after 1 s here instead of 20 s, so that a process which dies with
    the thread that started it (PR_SET_PDEATHSIG: bubblewrap's die-with-parent) dies within the tests,
    as a dogfooding session's kernels did between turns and while cells waited for a person.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.ThreadTimeoutMs" Value="1000" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fx.Host\Fx.Host.fsproj" />
  </ItemGroup>
</Project>
