<Project Sdk="Microsoft.NET.Sdk">
  <!--
    fx.sandbox.seatbelt's own behaviour: the Seatbelt profile a policy becomes (regions, parameters,
    the network, what stays in place) and the probe over a scripted shell. The live conformance
    suite runs in tests/Fx.Environments.Tests on macOS.
  -->
  <ItemGroup>
    <Compile Include="SeatbeltTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\extensions\Fx.Ext.SandboxSeatbelt\Fx.Ext.SandboxSeatbelt.fsproj" />
    <ProjectReference Include="..\..\src\Fx.Effects.Live\Fx.Effects.Live.fsproj" />
  </ItemGroup>
</Project>
