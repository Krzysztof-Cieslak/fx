[
  {
    "id": "agent.actionSurface",
    "owner": "core",
    "description": "How the agent acts: cells-only (one cell tool and finish) or hybrid (cells plus direct read, edit and bash tools).",
    "default": "cells-only",
    "choices": [
      "cells-only",
      "hybrid"
    ],
    "privileged": false,
    "schema": {
      "type": "string",
      "enum": [
        "cells-only",
        "hybrid"
      ]
    }
  },
  {
    "id": "edit.guard",
    "owner": "core",
    "description": "What editing a range the agent has not read does: off, warn, or require reading it first (an error).",
    "default": "warn",
    "choices": [
      "off",
      "warn",
      "require"
    ],
    "privileged": false,
    "schema": {
      "type": "string",
      "enum": [
        "off",
        "warn",
        "require"
      ]
    }
  },
  {
    "id": "values.previewLimits",
    "owner": "core",
    "description": "The bounds of value previews shown to models: characters, items, depth and string length.",
    "default": {
      "maxChars": 1000,
      "maxDepth": 3,
      "maxItems": 10,
      "maxStringChars": 120
    },
    "privileged": false,
    "schema": {
      "type": "object",
      "properties": {
        "maxChars": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "maxStringChars": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "maxChars",
        "maxItems",
        "maxDepth",
        "maxStringChars"
      ],
      "description": "Bounds for a preview."
    }
  },
  {
    "id": "values.inlineMaxBytes",
    "owner": "core",
    "description": "The largest value, in bytes of JSON, that is copied inline; larger values travel as blob references.",
    "default": 16384,
    "privileged": false,
    "schema": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    }
  },
  {
    "id": "shell.windows",
    "owner": "core",
    "description": "The shell that runs scripts on Windows: pwsh (PowerShell 7) or powershell (Windows PowerShell).",
    "default": "pwsh",
    "choices": [
      "pwsh",
      "powershell"
    ],
    "privileged": false,
    "schema": {
      "type": "string",
      "enum": [
        "pwsh",
        "powershell"
      ]
    }
  },
  {
    "id": "goal.context",
    "owner": "core",
    "description": "How a goal's iterations carry context: continue, compact, or fresh-handoff (a fresh session with a handoff).",
    "default": "fresh-handoff",
    "choices": [
      "continue",
      "compact",
      "fresh-handoff"
    ],
    "privileged": false,
    "schema": {
      "type": "string",
      "enum": [
        "continue",
        "compact",
        "fresh-handoff"
      ]
    }
  },
  {
