{
  "model": "claude-sonnet-5-5",
  "max_tokens": 32000,
  "messages": [
    { "role": "user", "content": [ { "type": "text", "text": "What changed in the working tree?" } ] }
  ],
  "tools": [
    {
      "name": "run_command",
      "description": "Runs a shell command in the repository.",
      "input_schema": {
        "type": "object",
        "properties": { "command": { "type": "string" } },
        "required": [ "command" ]
      }
    }
  ],
  "thinking": { "type": "adaptive" },
  "output_config": { "effort": "medium" },
  "stream": true
}
