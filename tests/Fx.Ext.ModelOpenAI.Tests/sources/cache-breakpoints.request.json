{
  "model": "gpt-6.2-sol",
  "input": [
    {
      "role": "developer",
      "content": [
        {
          "type": "input_text",
          "text": "You are a coding agent.",
          "prompt_cache_breakpoint": { "mode": "explicit", "ttl": "12h" }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "Repository map: src/Program.fs, src/Library.fs, tests/Tests.fs.",
          "prompt_cache_breakpoint": { "mode": "explicit" }
        }
      ]
    },
    { "role": "assistant", "content": "Noted.", "phase": "final_answer" },
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "Which file defines main?",
          "prompt_cache_breakpoint": { "mode": "explicit", "ttl": "12h" }
        }
      ]
    }
  ],
  "tools": [
    {
      "type": "function",
      "name": "read_file",
      "description": "Reads a file.",
      "parameters": {
        "type": "object",
        "properties": { "path": { "type": "string" } },
        "required": ["path"]
      },
      "strict": false
    }
  ],
  "reasoning": { "effort": "medium" },
  "include": ["reasoning.encrypted_content"],
  "max_output_tokens": 4096,
  "prompt_cache_key": "repo-fx",
  "store": false,
  "stream": true
}
