  "description": "The JSON shape of a value (a codec's schema), tagged by kind; every node may carry a description.",
  "$defs": {
    "SchemaBound": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inclusive"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exclusive"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ],
      "description": "A bound on a number: inclusive (minimum, maximum) or exclusive."
    },
    "SchemaCase": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaField"
          }
        },
        "unknownFields": {
          "type": "string",
          "enum": [
            "ignore",
            "reject"
          ],
          "description": "What a decoder does with members that are not fields: ignore them, or reject each one.",
          "default": "ignore"
        }
      },
      "required": [
        "tag",
        "fields"
      ],
      "additionalProperties": false,
      "description": "A case of a union: its tag and the fields next to the tag."
    },
    "SchemaField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "$ref": "#"
        },
        "presence": {
          "$ref": "#/$defs/SchemaPresence"
        }
      },
      "required": [
        "name",
        "schema",
        "presence"
      ],
      "additionalProperties": false,
      "description": "A field of an object or of a union case."
    },
    "SchemaPresence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "required"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "optional"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "defaulted"
            },
            "value": {}
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ],
      "description": "Whether a field must be present: required; optional (absent means no value); or defaulted (absent means this value, and it is always written)."
    }
  }
}
