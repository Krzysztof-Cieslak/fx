{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "done"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Match"
          },
          "default": []
        },
        "verify": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "description": "The work is complete."
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "needInput"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "decisions"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "waiting"
        },
        "on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "on",
        "note"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "moved"
        },
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "description": "A range of lines, end exclusive."
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cancelled"
        }
      },
      "required": [
        "kind"
      ]
    }
  ],
  "$defs": {
    "Match": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "score": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        },
        "sequence": {
          "type": "integer"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "path",
        "line",
        "text",
        "score",
        "weight",
        "sequence",
        "span",
        "priority",
        "counts"
      ]
    },
    "Span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "description": "A range of lines, end exclusive."
    }
  }
}
