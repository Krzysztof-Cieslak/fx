<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of src/Fx.CodeAct: its pure parts; turns end to end on the session host with the F# script
    kernel in process and a scripted model (both action surfaces, finishing, steering, interrupts,
    restarts, the loop guard, the policies, budgets, content exclusions); crash recovery (a host
    stopped mid-cell, the decision, each answer, recall); replay of the recorded logs
    into the requests sent; and the bun-ts kernel on the pinned Bun (skipped offline, required in CI).
  -->
  <ItemGroup>
    <Compile Include="..\Fx.Kernel.Tests\Repo.fs" Link="Bun\Repo.fs" />
    <Compile Include="..\Fx.Kernel.Tests\PinnedBun.fs" Link="Bun\PinnedBun.fs" />
    <!-- fx.env.local as the composition root wires it (envd embedded). -->
    <Compile Include="..\Fx.Environments.Tests\Conformance\ProviderConformance.fs" Link="Environments\ProviderConformance.fs" />
    <Compile Include="..\Fx.Environments.Tests\Local.fs" Link="Environments\Local.fs" />
    <Compile Include="Golden.fs" />
    <Compile Include="Support.fs" />
    <Compile Include="UnitTests.fs" />
    <Compile Include="RecoveryUnitTests.fs" />
    <Compile Include="TurnTests.fs" />
    <Compile Include="CrashTests.fs" />
    <Compile Include="ReplayTests.fs" />
    <Compile Include="ProviderTests.fs" />
    <Compile Include="LiveTests.fs" />
    <!-- T127b: the grants guard (command parsers, host calls as grants, the guard, turns that ask). -->
    <Compile Include="ShellSyntaxTests.fs" />
    <Compile Include="PermissionTests.fs" />
    <Compile Include="GrantTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fx.CodeAct\Fx.CodeAct.fsproj" />
    <ProjectReference Include="..\..\src\Fx.Effects.Live\Fx.Effects.Live.fsproj" />
    <ProjectReference Include="..\..\src\Fx.Envd.Live\Fx.Envd.Live.fsproj" />
    <ProjectReference Include="..\..\src\Fx.Grants.Host\Fx.Grants.Host.fsproj" />
    <!-- The bun-ts kernel, launched as the product launches it. -->
    <ProjectReference Include="..\..\extensions\Fx.Ext.InterpreterBunTs\Fx.Ext.InterpreterBunTs.fsproj" />
    <ProjectReference Include="..\..\extensions\Fx.Ext.RuntimeBun\Fx.Ext.RuntimeBun.fsproj" />
    <!-- The provider wires, on recorded-format streams. -->
    <ProjectReference Include="..\..\extensions\Fx.Ext.ModelAnthropic\Fx.Ext.ModelAnthropic.fsproj" />
    <ProjectReference Include="..\..\extensions\Fx.Ext.ModelOpenAI\Fx.Ext.ModelOpenAI.fsproj" />
    <ProjectReference Include="..\..\extensions\Fx.Ext.EnvLocal\Fx.Ext.EnvLocal.fsproj" />
    <!-- The script kernel. -->
    <ProjectReference Include="..\aot\Fx.Aot.Scenarios\Fx.Aot.Scenarios.fsproj" />
  </ItemGroup>
</Project>
