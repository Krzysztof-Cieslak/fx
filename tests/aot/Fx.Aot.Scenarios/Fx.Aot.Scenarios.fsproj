<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Scenarios whose output must be identical on the JIT and as a Native AOT binary (spec §20).
    Fx.Aot.Diff runs every scenario both ways and fails on any difference.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Same Native AOT setup as src/Fx.Cli: AOT for RID-specific builds only. -->
    <FxNativeAot>true</FxNativeAot>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Scenario.fs" />
    <Compile Include="Scenarios\Language.fs" />
    <Compile Include="Scenarios\Equality.fs" />
    <Compile Include="Scenarios\Generics.fs" />
    <Compile Include="Scenarios\Exceptions.fs" />
    <Compile Include="Scenarios\Collections.fs" />
    <Compile Include="Scenarios\Concurrency.fs" />
    <Compile Include="Scenarios\Effects.fs" />
    <Compile Include="Scenarios\Machines.fs" />
    <Compile Include="Scenarios\Text.fs" />
    <Compile Include="Scenarios\Runtime.fs" />
    <Compile Include="Scenarios\Kestrel\Support.fs" />
    <Compile Include="Scenarios\Kestrel\Http.fs" />
    <Compile Include="Scenarios\Kestrel\Access.fs" />
    <Compile Include="Scenarios\Kestrel\WebSockets.fs" />
    <Compile Include="Scenarios\Kestrel\EventStreams.fs" />
    <Compile Include="Scenarios\Kestrel\Transports.fs" />
    <Compile Include="Scenarios\Kestrel\Builders.fs" />
    <Compile Include="Scenarios\Contracts.fs" />
    <Compile Include="Scenarios\ContractsLarge.fs" />
    <Compile Include="Scenarios\Sqlite.fs" />
    <Compile Include="Scenarios\Pty.fs" />
    <Compile Include="Scenarios\Store.fs" />
    <Compile Include="Scenarios\Variants.fs" />
    <Compile Include="Scenarios\Rpc\TestService.fs" />
    <Compile Include="Scenarios\Rpc\Peer.fs" />
    <Compile Include="Scenarios\Rpc\Wire.fs" />
    <Compile Include="Scenarios\Rpc\Transcript.fs" />
    <Compile Include="Scenarios\Rpc\Transports.fs" />
    <Compile Include="Scenarios\Extensions\SampleHost.fs" />
    <Compile Include="Scenarios\Extensions\Extensions.fs" />
    <Compile Include="Scenarios\TypeScript.fs" />
    <Compile Include="..\..\Fx.Components.Tests\Support.fs" Link="Scenarios\ComponentsSupport.fs" />
    <Compile Include="Scenarios\Components.fs" />
    <Compile Include="Scenarios\Kernel\ScriptKernel.fs" />
    <Compile Include="Scenarios\Kernel\Kernel.fs" />
    <Compile Include="Scenarios\Runtimes.fs" />
    <Compile Include="Scenarios\Envd.fs" />
    <Compile Include="..\..\Fx.Models.Tests\Samples.fs" Link="Scenarios\ModelsSamples.fs" />
    <Compile Include="Scenarios\Models.fs" />
    <Compile Include="Scenarios\Interpreters.fs" />
    <Compile Include="Scenarios\Canary.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Fx.Effects.Live\Fx.Effects.Live.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Machines.Host\Fx.Machines.Host.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Prelude\Fx.Prelude.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Sqlite\Fx.Sqlite.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Pty\Fx.Pty.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Store.Live\Fx.Store.Live.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Transport.Http\Fx.Transport.Http.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Contracts\Fx.Contracts.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Contracts.TypeScript\Fx.Contracts.TypeScript.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Variants\Fx.Variants.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Rpc\Fx.Rpc.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Extensions\Fx.Extensions.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Components.Live\Fx.Components.Live.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Kernel\Fx.Kernel.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Envd.Live\Fx.Envd.Live.fsproj" />
    <ProjectReference Include="..\..\..\extensions\Fx.Ext.Sample\Fx.Ext.Sample.fsproj" />
    <ProjectReference Include="..\..\..\extensions\Fx.Ext.RuntimeBun\Fx.Ext.RuntimeBun.fsproj" />
    <ProjectReference Include="..\..\..\extensions\Fx.Ext.ModelCanonical\Fx.Ext.ModelCanonical.fsproj" />
    <ProjectReference Include="..\..\..\extensions\Fx.Ext.InterpreterBunTs\Fx.Ext.InterpreterBunTs.fsproj" />
    <ProjectReference Include="..\..\..\src\Fx.Interpreters\Fx.Interpreters.fsproj" />
