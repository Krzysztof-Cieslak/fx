<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The real interpreters of the core capabilities (the imperative shell, spec §1). Each file is the
    only reader of its part of the world and has its own reviewed entry in analyzers.json. Only
    composition roots (the host, envd, tests) reference this project. Spec: docs/modules/eff.md.
  -->

  <ItemGroup>
    <Compile Include="SystemClock.fs" />
    <Compile Include="SystemIds.fs" />
    <Compile Include="LocalFs.fs" />
    <Compile Include="LocalShell.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fx.Effects\Fx.Effects.fsproj" />
  </ItemGroup>
</Project>
