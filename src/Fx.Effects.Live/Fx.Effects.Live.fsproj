<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The real interpreters of the core capabilities (the imperative shell, spec §1). Each file is the
    only reader of its part of the world and has its own reviewed entry in analyzers.json. Only
    composition roots (the host, envd, tests) reference this project. Spec: docs/modules/eff.md.
  -->

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>The real interpreters of the core capabilities, for composition roots.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SystemClock.fs" />
    <Compile Include="SystemIds.fs" />
    <Compile Include="LocalFs.fs" />
    <Compile Include="ProcessStarter.fs" />
    <Compile Include="LocalShell.fs" />
    <Compile Include="SystemHttp.fs" />
    <Compile Include="SystemVariables.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fx.Prelude\Fx.Prelude.fsproj" />
    <ProjectReference Include="..\Fx.Effects\Fx.Effects.fsproj" />
  </ItemGroup>
</Project>
