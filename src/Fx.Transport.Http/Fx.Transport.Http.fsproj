<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Local HTTP transports on Kestrel (spec §3, §17, §18): a loopback, Unix-socket or named-pipe
    listener with WebSocket and server-sent events, behind a token, Origin and Host check, the OS
    account of each local peer, the listener's owner-only token file, and the WebSocket client that
    dials it. Native AOT verified by the kestrel-* and identity-* scenarios in tests/aot (T004,
    docs/spikes/kestrel.md; T122, docs/modules/identity.md).
  -->

  <ItemGroup>
    <Compile Include="LocalAccess.fs" />
    <Compile Include="PeerCredentials.fs" />
    <Compile Include="TokenFile.fs" />
    <Compile Include="Sse.fs" />
    <Compile Include="WebSocketMessages.fs" />
    <Compile Include="LocalServer.fs" />
    <Compile Include="LocalClient.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fx.Prelude\Fx.Prelude.fsproj" />
  </ItemGroup>
</Project>
