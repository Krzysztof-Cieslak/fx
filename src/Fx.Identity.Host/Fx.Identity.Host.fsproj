<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Principals on the host (spec §3: principals and session tokens are core; §11.2, §17): the
    session tokens (256 random bits, kept as SHA-256 hashes, expired by the clock, revoked by id or
    principal), the authenticator that asks the identity providers extensions contribute, and the
    identity side of the client protocol's `initialize`. Pure apart from the Eff capabilities it is
    handed: the EFF analyzers apply to every file. Spec: docs/modules/identity.md.
  -->
  <ItemGroup>
    <Compile Include="SessionTokens.fs" />
    <Compile Include="Authenticator.fs" />
    <Compile Include="IdentityServer.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fx.Identity\Fx.Identity.fsproj" />
    <ProjectReference Include="..\Fx.Sdk\Fx.Sdk.fsproj" />
    <ProjectReference Include="..\Fx.Machines\Fx.Machines.fsproj" />
    <ProjectReference Include="..\Fx.Rpc\Fx.Rpc.fsproj" />
  </ItemGroup>
</Project>
