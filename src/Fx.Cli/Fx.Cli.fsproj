<Project Sdk="Microsoft.NET.Sdk">
  <!-- The single native binary: CLI, host, envd and TUI (spec §20). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(FxProductName)</AssemblyName>
    <!--
      Native AOT for RID-specific builds only (dotnet publish -r <rid>): PublishAot in a RID-less
      evaluation makes restore add the host RID, so the committed lockfile would differ per OS.
      FxNativeAot makes Directory.Build.targets reject a publish without a RID.
    -->
    <FxNativeAot>true</FxNativeAot>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Cli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fx.Prelude\Fx.Prelude.fsproj" />
    <ProjectReference Include="..\Fx.Sqlite\Fx.Sqlite.fsproj" />
    <ProjectReference Include="..\Fx.Envd.Live\Fx.Envd.Live.fsproj" />
  </ItemGroup>
</Project>
