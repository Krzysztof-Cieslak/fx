<Project Sdk="Microsoft.NET.Sdk">
  <!-- The single native binary: CLI, host, envd and TUI (spec §20). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(FxProductName)</AssemblyName>
    <PublishAot>true</PublishAot>
    <!--
      With PublishAot, even a RID-less restore adds the host RID (for the ILCompiler host package),
      so a lockfile here would differ per OS. Its only extra packages are SDK-implicit and pinned
      by global.json. T003 decides how to lock RID-specific restores.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Cli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fx.Prelude\Fx.Prelude.fsproj" />
  </ItemGroup>
</Project>
