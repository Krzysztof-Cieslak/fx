<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Contracts (spec §4.1): the JSON AST, reader and writer, Schema, Validation, Preview and the Codec
    combinators. Depends only on FSharp.Core (Fx.Prelude may be added) and stays Fable-compatible: no
    System.Text.Json, spans or reflection. Module spec: docs/modules/contracts.md.
  -->

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Typed contracts: an exact JSON, Schema, and codec combinators with validation and bounded previews.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="JsonNumber.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="JsonReader.fs" />
    <Compile Include="JsonModule.fs" />
    <Compile Include="Issue.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Schema.fs" />
    <Compile Include="Preview.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Codecs.fs" />
  </ItemGroup>
</Project>
