<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The public F# SDK for extensions (spec §16.1): what an extension may see of the host. Built-in
    extensions (extensions/) reference this project and nothing else; the architecture tests in
    Fx.Extensions.Tests enforce it from the compiled metadata. It may expose only the projects it
    references here (Prelude, Contracts, Effects, Variants, Models): never the core (Fx.Extensions,
    Fx.Rpc, the machine host, the live interpreters). Pure: the EFF analyzers apply to every file.
    Spec: docs/modules/extensions.md.
  -->
  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>The public SDK for extensions: manifests, contribution types, the hook algebra, methods and activation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Versions.fs" />
    <Compile Include="ExtensionEnv.fs" />
    <Compile Include="InjectionVectors.fs" />
    <Compile Include="Manifest.fs" />
    <Compile Include="Remote.fs" />
    <Compile Include="Contribution.fs" />
    <Compile Include="Hooks.fs" />
    <Compile Include="Methods.fs" />
    <Compile Include="Extension.fs" />
    <Compile Include="BasicExtensionEnv.fs" />
    <Compile Include="VariantSlots.fs" />
    <Compile Include="Semver.fs" />
    <Compile Include="Component.fs" />
    <Compile Include="Runtime.fs" />
    <Compile Include="Models\Wire.fs" />
    <Compile Include="Models\Access.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fx.Prelude\Fx.Prelude.fsproj" />
    <ProjectReference Include="..\Fx.Contracts\Fx.Contracts.fsproj" />
    <ProjectReference Include="..\Fx.Effects\Fx.Effects.fsproj" />
    <ProjectReference Include="..\Fx.Variants\Fx.Variants.fsproj" />
    <ProjectReference Include="..\Fx.Models\Fx.Models.fsproj" />
  </ItemGroup>
</Project>
