{
  "manifest": {
    "id": "fx.sample",
    "version": "1.0.0",
    "description": "The sample extension: one of each hook kind, data and methods.",
    "sdk": "0.1",
    "protocol": "1",
    "placement": "host",
    "runtime": "bun",
    "requires": [],
    "capabilities": [
      "clock",
      "grants",
      "packages",
      "variants"
    ],
    "contributions": [
      {
        "type": "gate:sample.greeting",
        "id": "polite"
      },
      {
        "type": "gate:sample.greeting",
        "id": "fragile"
      },
      {
        "type": "transform:sample.text",
        "id": "trim"
      },
      {
        "type": "transform:sample.text",
        "id": "shout"
      },
      {
        "type": "transform:sample.text",
        "id": "bracket"
      },
      {
        "type": "transform:sample.text",
        "id": "guard"
      },
      {
        "type": "sample.word",
        "id": "alpha"
      },
      {
        "type": "sample.word",
        "id": "beta"
      },
      {
        "type": "observe:sample.note",
        "id": "recorder"
      },
      {
        "type": "observe:sample.note",
        "id": "flaky"
      },
      {
        "type": "variant-slot",
        "id": "sample.style"
      }
    ],
    "rpc": {
      "methods": [
        {
          "name": "echo",
          "description": "Returns the note it is given.",
          "params": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          },
          "result": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          }
        },
        {
          "name": "divide",
          "description": "Integer division; dividing by zero is a typed error.",
          "params": {
            "type": "object",
            "properties": {
              "dividend": {
                "type": "integer"
              },
              "divisor": {
                "type": "integer"
              }
            },
            "required": [
              "dividend",
              "divisor"
            ]
          },
          "result": {
            "type": "integer"
          }
        },
        {
          "name": "observed",
          "description": "The notes the recorder has seen, in order.",
          "params": {
            "type": "null"
          },
          "result": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "fail",
          "description": "Throws: a defect.",
          "params": {
            "type": "null"
          },
          "result": {
            "type": "null"
          }
        },
        {
          "name": "style",
          "description": "The value of the sample's style slot (the variants capability).",
          "params": {
            "type": "null"
          },
          "result": {
            "type": "string"
          }
        },
        {
          "name": "packages",
          "description": "The ids of the extensions in effect (the packages capability).",
          "params": {
            "type": "null"
          },
          "result": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "data",
          "description": "The data contributions of a type in effect (the packages capability).",
          "params": {
            "type": "string"
          },
          "result": {
            "type": "array",
            "items": {}
          }
        },
        {
          "name": "check",
          "description": "Checks a grant query (the grants capability): a GrantQuery in, a GrantCheck out.",
          "params": {},
          "result": {}
        },
        {
          "name": "ask",
          "description": "Asks for a permission (the grants capability): a GrantAsk in, an AskOutcome out.",
          "params": {},
          "result": {}
        }
      ]
    },
    "replaces": []
  },
  "hash": "sha256:6e14e790a973e56ad92eabdf5aba33d6b67ce084358c266ec1e4f63457be0519"
}
