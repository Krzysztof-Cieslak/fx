<Project>
  <!--
    The pinned tree-sitter and its grammars (T008, docs/spikes/tree-sitter.md). Each archive is
    downloaded, checked against the SHA-256 below and compiled by TreeSitter.targets into one library.

    Archives (FxTreeSitterArchive): Url, Sha256, and Strip (the leading directories tar strips: 1 for
    GitHub's tag archives, which hold one top directory; 0 for the release tarballs grammars publish).
    Release tarballs are uploaded files and never change; tag archives are generated by GitHub, whose
    tarballs are stable but not promised to be, so prefer a release tarball where a project has one.

    Grammars (FxTreeSitterGrammar): the archive they come from, the directory holding parser.c and
    scanner.c in it, and the C function that returns the language. The binding lists the same
    languages (src/Fx.TreeSitter/Languages.fs); its tests fail when one is missing from the library.

    To bump: take the release, download its archive, record its SHA-256 and version here. A grammar's
    parser.c states its ABI (LANGUAGE_VERSION); the core's TREE_SITTER_MIN_COMPATIBLE_LANGUAGE_VERSION
    to TREE_SITTER_LANGUAGE_VERSION must include it, and the tests check every grammar loads.
  -->
  <PropertyGroup Label="tree-sitter pin">
    <FxTreeSitterVersion>0.27.2</FxTreeSitterVersion>
  </PropertyGroup>

  <ItemGroup Label="tree-sitter archives">
    <FxTreeSitterArchive Include="tree-sitter-0.27.2">
      <Url>https://github.com/tree-sitter/tree-sitter/archive/refs/tags/v0.27.2.tar.gz</Url>
      <Sha256>356528363bf7fbad12a2cfeb5a2678c0118ef886a4d69ad9a379db5fdef0735f</Sha256>
      <Strip>1</Strip>
    </FxTreeSitterArchive>
    <FxTreeSitterArchive Include="tree-sitter-fsharp-0.3.13">
      <Url>https://github.com/ionide/tree-sitter-fsharp/releases/download/0.3.13/tree-sitter-fsharp.tar.gz</Url>
      <Sha256>a336b9b210a4136b6e0272c8f8a9df7da86457f509a1fd80163179b7e6f2a818</Sha256>
      <Strip>0</Strip>
    </FxTreeSitterArchive>
    <FxTreeSitterArchive Include="tree-sitter-c-sharp-0.24.0">
      <Url>https://github.com/tree-sitter/tree-sitter-c-sharp/releases/download/v0.24.0/tree-sitter-c-sharp.tar.gz</Url>
      <Sha256>f916b4014ba2ae21c536177a95dde75b0553fd4740718c79dda7057e44fc5f58</Sha256>
      <Strip>0</Strip>
    </FxTreeSitterArchive>
    <FxTreeSitterArchive Include="tree-sitter-python-0.25.0">
      <Url>https://github.com/tree-sitter/tree-sitter-python/releases/download/v0.25.0/tree-sitter-python.tar.gz</Url>
      <Sha256>7bce887eb2f33e94bf74a69645cf5138d4096720e54fd3269a6124c06b93c584</Sha256>
      <Strip>0</Strip>
    </FxTreeSitterArchive>
    <!-- The release's tarball is .tar.xz, which Windows' tar cannot read everywhere; the tag archive holds the same generated sources. -->
    <FxTreeSitterArchive Include="tree-sitter-typescript-0.23.2">
      <Url>https://github.com/tree-sitter/tree-sitter-typescript/archive/refs/tags/v0.23.2.tar.gz</Url>
      <Sha256>2c4ce711ae8d1218a3b2f899189298159d672870b5b34dff5d937bed2f3e8983</Sha256>
      <Strip>1</Strip>
    </FxTreeSitterArchive>
  </ItemGroup>

  <ItemGroup Label="tree-sitter grammars">
    <FxTreeSitterGrammar Include="fsharp">
      <Archive>tree-sitter-fsharp-0.3.13</Archive>
      <Source>fsharp/src</Source>
      <Function>tree_sitter_fsharp</Function>
    </FxTreeSitterGrammar>
    <FxTreeSitterGrammar Include="fsharp_signature">
      <Archive>tree-sitter-fsharp-0.3.13</Archive>
      <Source>fsharp_signature/src</Source>
      <Function>tree_sitter_fsharp_signature</Function>
    </FxTreeSitterGrammar>
    <FxTreeSitterGrammar Include="c_sharp">
      <Archive>tree-sitter-c-sharp-0.24.0</Archive>
      <Source>src</Source>
      <Function>tree_sitter_c_sharp</Function>
    </FxTreeSitterGrammar>
    <FxTreeSitterGrammar Include="python">
      <Archive>tree-sitter-python-0.25.0</Archive>
      <Source>src</Source>
      <Function>tree_sitter_python</Function>
    </FxTreeSitterGrammar>
    <FxTreeSitterGrammar Include="typescript">
      <Archive>tree-sitter-typescript-0.23.2</Archive>
      <Source>typescript/src</Source>
      <Function>tree_sitter_typescript</Function>
    </FxTreeSitterGrammar>
    <FxTreeSitterGrammar Include="tsx">
      <Archive>tree-sitter-typescript-0.23.2</Archive>
      <Source>tsx/src</Source>
      <Function>tree_sitter_tsx</Function>
    </FxTreeSitterGrammar>
  </ItemGroup>

  <PropertyGroup Label="tree-sitter library">
    <!-- The DllImport name: unique, so the JIT never loads another tree-sitter. Native AOT binds it at link time (DirectPInvoke). -->
    <FxTreeSitterLibraryName>Fx.TreeSitter.Native</FxTreeSitterLibraryName>
    <!-- Keep in step with FxSqliteMacOSMinVersion (AppleMinOSVersion of the pinned SDK's ILCompiler). -->
    <FxTreeSitterMacOSMinVersion>14.0</FxTreeSitterMacOSMinVersion>
  </PropertyGroup>
</Project>
